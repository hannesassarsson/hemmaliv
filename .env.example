VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Shared password gate. Leave empty to disable. Not a real security boundary,
# just keeps casual visitors out — remembered per browser via localStorage.
VITE_APP_PASSWORD=
# Only needed when push notifications have been configured.
VITE_VAPID_PUBLIC_KEY=
# Server-only variables for the scheduled Vercel notification function.
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
# Server-only. Private published calendar (webcal:// or https://) used by
# /api/family-calendar. Never exposed to the frontend or committed.
FAMILY_CALENDAR_ICS_URL=
